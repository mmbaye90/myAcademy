package Database;


import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;

import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;



public class ConnectionManager {
    private static final String url = "jdbc:mysql://localhost:3306/jeuxVideo";
    private static final String utilisateur = "root";
    private static final String motDePasse = "";
    private static Connection connexion = null; 
   
    private static HikariDataSource dataSource;
    
    static {
    	
    	var config = new HikariConfig();
    	
    	//SINGLETON CONNEXION SETTING
    	config.setJdbcUrl(url);
    	config.setUsername(utilisateur);
    	config.setPassword(motDePasse);
    	
    	//POOL CONNEXION SETTING
    	config.setMaximumPoolSize(10);
    	config.setMinimumIdle(2);
    	config.setLeakDetectionThreshold(0);
    	config.setDriverClassName("com.mysql.jdbc.Driver");
    	
    	//AFFECTATION DATASOURCE
    	dataSource = new HikariDataSource(config); 	
    };

    public static Connection getConnection() {
    	
    	try {
    		
    		
    		if (connexion == null) {
				throw new IllegalStateException("La datasource HC n'est pas initialisée");
			}
    		
    		connexion = dataSource.getConnection();
    		
    		System.out.println("CONNEXION A LA BD REUSSIE");
    		
		} catch (SQLException e) {
			
			System.out.println("CONNEXION A LA BD ECHOUEE");
			
			e.printStackTrace();
		}
    	
    	return connexion;
    };
    
    
    
   
