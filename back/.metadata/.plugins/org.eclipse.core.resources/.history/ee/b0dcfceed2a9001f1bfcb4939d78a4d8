package Database;


import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;

import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;



public class ConnectionManager {
    private static final String url = "jdbc:mysql://localhost:3306/jeuxVideo";
    private static final String utilisateur = "root";
    private static final String motDePasse = "";
    private static Connection connexion = null; 
   
   
    
    static {
    	
    	
    };

    public static Connection getConnectionHikariCp() {
    	
    	try {
    		
    		connexion = dataSource.getConnection();
    		if (connexion == null) {
				throw new IllegalStateException("La datasource HC n'est pas initialisée");
			}
    		
    		System.out.println("CONNEXION A LA BD REUSSIE");
    		
		} catch (SQLException e) {
			
			System.out.println("CONNEXION A LA BD ECHOUEE");
			
			e.printStackTrace();
		}
    	
    	return connexion;
    };
    
    
    
   
	public static Connection getConnection() {
        try {
            if (connexion == null || connexion.isClosed()) {
               
                Class.forName("com.mysql.jdbc.Driver");
                
                connexion = DriverManager.getConnection(url, utilisateur, motDePasse);
                System.out.println("CONNEXION TO DB SUCCESS !!!");
            }
        } catch (SQLException | ClassNotFoundException ex) {
        	System.out.println("CONNEXION TO DB FAILLED !!!");
        	ex.printStackTrace();
        }
        return connexion;
    }
	
	
	public void closedConnexion() {
		
		if (dataSource != null) {
			
			dataSource.close();
			
			System.out.println("CONNEXION CLOSED");
		}
		
	};
	
	//============================== FIN METHODE ===================

}
